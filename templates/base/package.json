{
  "name": "my-product", "version": "0.1.0", "private": true, "type": "module",
  "allowScripts": { "unrs-resolver": true, "esbuild": true },
  "engines": { "node": "^24.15.0 || >=26.0.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1", "build": "next build", "start": "next start",
    "typecheck": "next typegen && tsc --noEmit", "lint": "eslint",
    "test": "vitest run", "test:watch": "vitest", "test:coverage": "vitest run --coverage",
    "test:e2e:install": "playwright install chromium", "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "media:optimize": "node scripts/optimize-media.mjs", "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs"
  },
  "dependencies": { "next": "16.3.6", "react": "19.3.0", "react-dom": "19.3.0", "server-only": "0.0.1", "zod": "4.6.5" },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3", "tailwindcss": "4.3.3", "postcss": "8.5.28",
    "typescript": "npm:@typescript/typescript6@6.0.2", "@typescript/native": "npm:typescript@7.0.2", "@types/node": "26.6.2", "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "eslint": "9.39.5", "eslint-config-next": "16.3.6",
    "vitest": "5.0.1", "@vitest/coverage-v8": "5.0.1", "@testing-library/react": "16.3.3", "@testing-library/jest-dom": "7.0.1", "jsdom": "30.1.1",
    "@playwright/test": "1.63.0", "sharp": "0.35.4"
  }
}
